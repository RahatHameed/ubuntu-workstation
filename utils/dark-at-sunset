#!/usr/bin/env python3
"""Switch the GNOME colour scheme to dark at sunset and back at sunrise.

GNOME has no built-in day/night theme switching -- Night Light is a different
thing, it only warms the screen's colour temperature. This fills that gap with a
systemd user timer rather than a shell extension, so it needs no logout to take
effect and survives GNOME upgrades.

Coordinates default to those of the system timezone, from tzdata's zone.tab.
That is accurate to the zone's reference city, which is within a few minutes of
sunset for anywhere in the same country; override with --lat/--lon if you care.

Setting the colour scheme is not enough on its own for GTK3 apps: on Ubuntu they
take their dark variant from the theme name, not from colour-scheme, so the
gtk-theme setting is swapped between Yaru and Yaru-dark too. Without that,
GNOME Terminal and every other GTK3 window stays as it was. See sync_gtk_theme.

GNOME Terminal needs more than the theme name again, and for a different
reason: Yaru paints terminal-screen the Ubuntu aubergine #300A24 in its light
stylesheet as well as its dark one, so a profile left on "use colours from
system theme" is dark at noon. The profile's own colours are swapped instead.
See sync_terminal.

Claude Code's own theme is followed along too, since it is a TUI with its own
palette that does not read the desktop's preference. See sync_claude.

Standard library only.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import subprocess
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

SCHEMA = "org.gnome.desktop.interface"
KEY = "color-scheme"
DARK = "prefer-dark"
LIGHT = "default"

ZONE_TAB = "/usr/share/zoneinfo/zone.tab"

GTK_THEME_KEY = "gtk-theme"
# Yaru's names are Yaru[-accent][-dark][-hdpi|-xhdpi], so -dark belongs before
# any hidpi suffix rather than at the end.
HIDPI_SUFFIXES = ("-hdpi", "-xhdpi")
THEME_DIRS = (Path("/usr/share/themes"),
              Path.home() / ".themes",
              Path.home() / ".local" / "share" / "themes")

CLAUDE_SETTINGS = Path.home() / ".claude" / "settings.json"

TERM_LIST = "org.gnome.Terminal.ProfilesList"
TERM_PROFILE = ("org.gnome.Terminal.Legacy.Profile:"
                "/org/gnome/terminal/legacy/profiles:/:{uuid}/")
# Dark keeps Ubuntu's aubergine, so nights look as they always have; light is
# the pair GNOME Terminal itself defaults to.
TERM_COLORS = {DARK: ("#300A24", "#FFFFFF"), LIGHT: ("#FFFFFF", "#171421")}


def current_timezone() -> str:
    out = subprocess.run(["timedatectl", "show", "-p", "Timezone", "--value"],
                         capture_output=True, text=True)
    return out.stdout.strip() or "UTC"


def _dms(text: str, deg_digits: int) -> float:
    """Parse zone.tab's ISO 6709 form, e.g. +5230 or +01322, into degrees."""
    sign = -1.0 if text[0] == "-" else 1.0
    body = text[1:]
    deg = float(body[:deg_digits])
    minutes = float(body[deg_digits:deg_digits + 2] or 0)
    seconds = float(body[deg_digits + 2:deg_digits + 4] or 0)
    return sign * (deg + minutes / 60 + seconds / 3600)


def coords_for(tz: str) -> tuple[float, float] | None:
    try:
        with open(ZONE_TAB, encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 3 and parts[2] == tz:
                    c = parts[1]
                    # Latitude is +DDMM or +DDMMSS; longitude +DDDMM or +DDDMMSS.
                    split = 5 if len(c) in (11, 15) else 5
                    return _dms(c[:split], 2), _dms(c[split:], 3)
    except OSError:
        pass
    return None


def sun_times(day: date, lat: float, lon: float) -> tuple[datetime, datetime] | str:
    """Sunrise and sunset in UTC, or a string when the sun does not do both.

    NOAA's approximation. Accurate to about a minute, which is far finer than
    anyone notices in a theme switch.
    """
    n = day.timetuple().tm_yday
    gamma = 2 * math.pi / 365 * (n - 1 + 0.5)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(gamma)
                       - 0.032077 * math.sin(gamma)
                       - 0.014615 * math.cos(2 * gamma)
                       - 0.040849 * math.sin(2 * gamma))
    decl = (0.006918 - 0.399912 * math.cos(gamma) + 0.070257 * math.sin(gamma)
            - 0.006758 * math.cos(2 * gamma) + 0.000907 * math.sin(2 * gamma)
            - 0.002697 * math.cos(3 * gamma) + 0.00148 * math.sin(3 * gamma))

    lat_r = math.radians(lat)
    # 90.833 deg accounts for refraction and the sun's disc.
    cos_ha = (math.cos(math.radians(90.833)) / (math.cos(lat_r) * math.cos(decl))
              - math.tan(lat_r) * math.tan(decl))
    if cos_ha > 1:
        return "polar night"
    if cos_ha < -1:
        return "midnight sun"
    ha = math.degrees(math.acos(cos_ha))

    midnight = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
    rise = midnight + timedelta(minutes=720 - 4 * (lon + ha) - eqtime)
    set_ = midnight + timedelta(minutes=720 - 4 * (lon - ha) - eqtime)
    return rise, set_


def wanted_scheme(now: datetime, lat: float, lon: float) -> tuple[str, str]:
    times = sun_times(now.date(), lat, lon)
    if isinstance(times, str):
        # Above the Arctic circle the sensible fallback is dark in winter.
        return (DARK if times == "polar night" else LIGHT), times
    rise, set_ = times
    if rise <= now < set_:
        return LIGHT, f"sunrise {rise.astimezone():%H:%M}, sunset {set_.astimezone():%H:%M}"
    return DARK, f"sunrise {rise.astimezone():%H:%M}, sunset {set_.astimezone():%H:%M}"


def get_scheme() -> str:
    out = subprocess.run(["gsettings", "get", SCHEMA, KEY],
                         capture_output=True, text=True)
    return out.stdout.strip().strip("'")


def set_scheme(value: str) -> bool:
    return subprocess.run(["gsettings", "set", SCHEMA, KEY, value]).returncode == 0


def theme_installed(name: str) -> bool:
    return any((d / name / "gtk-3.0").is_dir() for d in THEME_DIRS)


def gtk_theme_for(scheme: str, current: str) -> str | None:
    """The counterpart of a GTK theme name for a colour scheme, or None if none.

    Handles the Yaru naming above and the plain Adwaita/Adwaita-dark pattern,
    which is the same rule with no accent or hidpi part. Returns None when the
    counterpart is not installed, rather than pointing gtk-theme at nothing.
    """
    stem, suffix = current, ""
    for candidate in HIDPI_SUFFIXES:
        if stem.endswith(candidate):
            stem, suffix = stem[:-len(candidate)], candidate
            break
    is_dark = stem.endswith("-dark")
    if is_dark:
        stem = stem[:-len("-dark")]

    want_dark = scheme == DARK
    if want_dark == is_dark:
        return current
    wanted = f"{stem}-dark{suffix}" if want_dark else f"{stem}{suffix}"
    return wanted if theme_installed(wanted) else None


def sync_gtk_theme(scheme: str) -> str | None:
    """Swap gtk-theme to the matching variant. Returns a note.

    GTK3 apps on Ubuntu do not follow colour-scheme at all -- their
    gtk-application-prefer-dark-theme stays off however that key is set, which is
    why GNOME's own Appearance panel changes the theme name as well as the
    scheme. Doing the same here is what actually turns GNOME Terminal, and any
    other GTK3 window, dark. Running apps pick the new theme up immediately.
    """
    out = subprocess.run(["gsettings", "get", SCHEMA, GTK_THEME_KEY],
                         capture_output=True, text=True)
    have = out.stdout.strip().strip("'")
    if not have:
        return None

    want = gtk_theme_for(scheme, have)
    if want is None:
        return f"gtk theme: {have} has no counterpart installed, left alone"
    if want == have:
        return None
    if subprocess.run(["gsettings", "set", SCHEMA, GTK_THEME_KEY, want]).returncode:
        return "gtk theme: gsettings failed"
    return f"gtk theme: {have} -> {want}"


def terminal_profile() -> str | None:
    """The default GNOME Terminal profile's UUID, or None if there is not one."""
    out = subprocess.run(["gsettings", "get", TERM_LIST, "default"],
                         capture_output=True, text=True)
    if out.returncode:
        return None
    return out.stdout.strip().strip("'") or None


def sync_terminal(scheme: str) -> str | None:
    """Swap the default terminal profile's colours. Returns a note.

    theme-variant only gets GNOME Terminal's window chrome to follow the scheme;
    the screen itself takes its colours from the profile, and a profile set to
    use the theme's gets Yaru's hardcoded aubergine in either variant. So
    use-theme-colors is turned off and the two colours set here instead. VTE
    applies them to windows that are already open, so nothing needs closing.
    """
    uuid = terminal_profile()
    if uuid is None:
        return None
    path = TERM_PROFILE.format(uuid=uuid)
    bg, fg = TERM_COLORS[scheme]

    out = subprocess.run(["gsettings", "get", path, "background-color"],
                         capture_output=True, text=True)
    if out.returncode:
        return None
    had = out.stdout.strip().strip("'")

    # use-theme-colors last: while it is on the other two are ignored, so
    # turning it off first would show the old colours for a frame.
    for key, value in (("background-color", bg), ("foreground-color", fg),
                       ("use-theme-colors", "false")):
        if subprocess.run(["gsettings", "set", path, key, value]).returncode:
            return f"terminal: could not set {key}"
    return None if had.upper() == bg.upper() else f"terminal: {had} -> {bg}"


def claude_theme_for(scheme: str, current: str) -> str:
    """The Claude Code theme matching a GNOME colour scheme.

    Claude Code offers no "follow the system" theme, only six fixed values:
    {dark,light} x {"", -daltonized, -ansi}. So the variant the user picked is
    kept and only the light/dark half is swapped -- flipping a colourblind
    -daltonized theme to plain "light" at sunrise would be a rude surprise.
    """
    variant = ""
    for suffix in ("-daltonized", "-ansi"):
        if current.endswith(suffix):
            variant = suffix
            break
    return ("dark" if scheme == DARK else "light") + variant


def sync_claude(scheme: str) -> str | None:
    """Point Claude Code's theme at the same half of the day. Returns a note.

    Claude Code reads settings.json at startup, so this takes effect for the
    next session rather than any that is already open. Nothing here is worth
    failing the run over -- the desktop switch is the job, this is a courtesy.
    """
    if not CLAUDE_SETTINGS.is_file():
        return None
    try:
        with CLAUDE_SETTINGS.open(encoding="utf-8") as fh:
            settings = json.load(fh)
    except (OSError, ValueError) as exc:
        return f"claude: could not read settings.json ({exc})"
    if not isinstance(settings, dict):
        return "claude: settings.json is not an object, left alone"

    have = settings.get("theme", "")
    want = claude_theme_for(scheme, have if isinstance(have, str) else "")
    if have == want:
        return None

    settings["theme"] = want
    # Write via a temp file in the same directory so a crash mid-write cannot
    # leave Claude Code with a truncated settings.json.
    tmp = CLAUDE_SETTINGS.with_suffix(".json.tmp")
    try:
        with tmp.open("w", encoding="utf-8") as fh:
            json.dump(settings, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, CLAUDE_SETTINGS)
    except OSError as exc:
        tmp.unlink(missing_ok=True)
        return f"claude: could not write settings.json ({exc})"
    return f"claude: {have or 'unset'} -> {want} (applies to the next session)"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("command", nargs="?", default="apply",
                    choices=["apply", "status", "dark", "light"],
                    help="apply (default), status, or force dark/light once")
    ap.add_argument("--lat", type=float, help="latitude, north positive")
    ap.add_argument("--lon", type=float, help="longitude, east positive")
    ap.add_argument("--no-claude", action="store_true",
                    help="leave Claude Code's theme alone")
    ap.add_argument("--no-gtk-theme", action="store_true",
                    help="leave the GTK theme alone; GTK3 apps will not switch")
    ap.add_argument("--no-terminal", action="store_true",
                    help="leave GNOME Terminal's profile colours alone")
    args = ap.parse_args()

    tz = current_timezone()
    lat, lon = args.lat, args.lon
    if lat is None or lon is None:
        found = coords_for(tz)
        if not found:
            print(f"dark-at-sunset: no coordinates for {tz}; pass --lat/--lon",
                  file=sys.stderr)
            return 1
        lat, lon = found

    now = datetime.now(ZoneInfo(tz)).astimezone(timezone.utc)
    want, why = wanted_scheme(now, lat, lon)

    if args.command == "dark":
        want, why = DARK, "forced"
    elif args.command == "light":
        want, why = LIGHT, "forced"

    have = get_scheme()
    if args.command == "status":
        print(f"timezone : {tz}  ({lat:.2f}, {lon:.2f})")
        print(f"today    : {why}")
        print(f"scheme   : {have}   wanted: {want}")
        if not args.no_gtk_theme:
            out = subprocess.run(["gsettings", "get", SCHEMA, GTK_THEME_KEY],
                                 capture_output=True, text=True)
            theme = out.stdout.strip().strip("'")
            print(f"gtk theme: {theme}   wanted: {gtk_theme_for(want, theme) or theme}")
        if not args.no_terminal:
            uuid = terminal_profile()
            if uuid:
                out = subprocess.run(
                    ["gsettings", "get", TERM_PROFILE.format(uuid=uuid),
                     "background-color"], capture_output=True, text=True)
                bg = out.stdout.strip().strip("'")
                print(f"terminal : {bg}   wanted: {TERM_COLORS[want][0]}")
        if not args.no_claude and CLAUDE_SETTINGS.is_file():
            try:
                theme = json.loads(CLAUDE_SETTINGS.read_text(encoding="utf-8")).get("theme", "unset")
            except (OSError, ValueError):
                theme = "unreadable"
            print(f"claude   : {theme}   wanted: {claude_theme_for(want, str(theme))}")
        return 0

    # Before the scheme, so the two do not disagree for a frame, and outside the
    # have == want check: the theme can be changed on its own in the Appearance
    # panel, so it may need catching up when the scheme is already right.
    if not args.no_gtk_theme:
        note = sync_gtk_theme(want)
        if note:
            print(f"dark-at-sunset: {note}")

    # Same reasoning as the theme above: the profile can be edited in the
    # terminal's own preferences, so it may need catching up on its own.
    if not args.no_terminal:
        note = sync_terminal(want)
        if note:
            print(f"dark-at-sunset: {note}")

    if have == want:
        print(f"dark-at-sunset: already {want} ({why})")
    elif not set_scheme(want):
        print("dark-at-sunset: gsettings failed", file=sys.stderr)
        return 1
    else:
        print(f"dark-at-sunset: {have} -> {want} ({why})")

    # Runs even when the desktop was already right: Claude Code's theme can be
    # changed independently with /theme, so it may need catching up on its own.
    if not args.no_claude:
        note = sync_claude(want)
        if note:
            print(f"dark-at-sunset: {note}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
